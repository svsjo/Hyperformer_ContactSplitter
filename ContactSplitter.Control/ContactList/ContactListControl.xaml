<UserControl x:Class="ContactSplitter.Control.ContactList.ContactListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactSplitter.Control.ContactList"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=local:ContactListViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid >
        <StackPanel Orientation="Vertical">
            <ui:DataGrid ItemsSource="{Binding ContactsView}" AutoGenerateColumns="False" Height="625">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#355A61"></Setter>
                        <Setter Property="FontWeight" Value="Bold"></Setter>
                        <Setter Property="Height" Value="30"></Setter>
                        <Setter Property="Margin" Value="0,10,0,0"></Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="230" Header="Anrede" Binding="{Binding Salutation, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="230" Header="Brief-Anrede" Binding="{Binding LetterSalutation, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="230" Header="Titel" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="80" Header="Geschlecht" Binding="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="205" Header="Vorname" Binding="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Width="205" Header="Nachname" Binding="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Header="Löschen" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" Width="80"
                                        Command="{Binding DataContext.DeleteContactCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:DataGrid}}}" 
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
            
            <StackPanel Orientation="Horizontal" Height="40" Margin="10,10,0,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="250" Focusable="True"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>

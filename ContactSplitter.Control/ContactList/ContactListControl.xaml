<UserControl x:Class="ContactSplitter.Control.ContactList.ContactListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactSplitter.Control.ContactList"
             d:DataContext="{d:DesignInstance Type=local:ContactListViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Red">
        <ListView ItemsSource="{Binding AllContacts}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Anrede" DisplayMemberBinding="{Binding Salutation}" />
                    <GridViewColumn Header="Brief-Anrede" DisplayMemberBinding="{Binding LetterSalutation}" />
                    <GridViewColumn Header="Titel" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Geschlecht" DisplayMemberBinding="{Binding Gender}" />
                    <GridViewColumn Header="Vorname" DisplayMemberBinding="{Binding ForeName}" />
                    <GridViewColumn Header="Nachname" DisplayMemberBinding="{Binding LastName}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>

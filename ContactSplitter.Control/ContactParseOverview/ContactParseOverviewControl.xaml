<UserControl x:Class="ContactSplitter.Control.ContactParseOverview.ContactParseOverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactSplitter.Control.ContactParseOverview"
             d:DataContext="{d:DesignInstance Type=local:ContactParseViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#6B818C">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBox IsEnabled="False" Margin="0,0,5,0" Text="Unformatierte Eingabe"></TextBox>
                <TextBox Text="{Binding Input}" Width="840" Height="40"></TextBox>
                <Button Command="{Binding ParseCommand}" Content="Parse" Margin="5,0,5,0" Width="120"></Button>
                <Button Command="{Binding SaveCommand}" Content="Save" Width="120"></Button>
            </StackPanel>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,10,0,10" />
            <StackPanel Orientation="Horizontal" Margin="10">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBox IsReadOnly="True" IsEnabled="False" Text="Anrede" Margin="0,0,5,0" Width="102"></TextBox>
                        <TextBox  Text="{Binding Salutation}" Width="495"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBox IsReadOnly="True" IsEnabled="False" Text="Brief-Anrede" Margin="0,0,5,0" Width="102"></TextBox>
                        <TextBox  Text="{Binding LetterSalutation}" Width="495"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox IsReadOnly="True" IsEnabled="False" Text="Titel" Margin="0,0,5,0" Width="102"></TextBox>
                        <TextBox  Text="{Binding Title}" Width="495"></TextBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="100,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBox IsReadOnly="True" IsEnabled="False" Text="Geschlecht" Margin="0,0,5,0" Width="102"></TextBox>
                        <TextBox  Text="{Binding Gender}" Width="450"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <TextBox IsReadOnly="True" IsEnabled="False" Text="Vorname" Margin="0,0,5,0" Width="102"></TextBox>
                        <TextBox  Text="{Binding ForeName}" Width="450"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                        <TextBox IsReadOnly="True" IsEnabled="False" Text="Nachname" Margin="0,0,5,0" Width="102"></TextBox>
                        <TextBox  Text="{Binding LastName}" Width="450"></TextBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel  Orientation="Horizontal" Margin="10">
                <TextBox IsReadOnly="True"  Text="Nicht geparste Wörter" IsEnabled="False"></TextBox>
                <TextBox  Text="{Binding NotParsed}" Margin="5,0,0,0" Width="435"></TextBox>
            </StackPanel>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,10,0,10" />
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBox IsReadOnly="True" Text="Anmerkungen" IsEnabled="False" Width="120"></TextBox>
                <TextBox IsReadOnly="True" Width="1140" 
                         Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" Margin="5,0,0,0"></TextBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

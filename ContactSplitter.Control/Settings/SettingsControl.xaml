<UserControl x:Class="ContactSplitter.Control.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactSplitter.Control.Settings"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid Background="#35605A">
        <StackPanel Orientation="Vertical" Margin="20">
            <TextBlock Text="Zulässige Titel" FontSize="24" FontWeight="Bold" Foreground="White" TextAlignment="Left" Margin="0 0 0 10" />
            <StackPanel Orientation="Vertical">
                <ListBox ItemsSource="{Binding AllTitles}" Height="520" Width="230" HorizontalAlignment="Left">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Height="25" FontSize="15" Text="{Binding}" Margin="5,0" Width="120"/>
                                <Button Height="25" FontSize="11" Content="Remove" Command="{Binding DataContext.RemoveTitleCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding NewTitle, Mode=TwoWay}" Margin="0,10" Width="175"/>
                    <Button Content="Add" Command="{Binding AddTitleCommand}" Margin="5,0,0,0" Height="35"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="ContactSplitter.Control.MainContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactSplitter.Control"
             xmlns:mainContainer="clr-namespace:ContactSplitter.Control"
             xmlns:contactList="clr-namespace:ContactSplitter.Control.ContactList"
             xmlns:settings="clr-namespace:ContactSplitter.Control.Settings"
             xmlns:contactParseOverview="clr-namespace:ContactSplitter.Control.ContactParseOverview"
             d:DataContext="{d:DesignInstance Type=local:MainContainerViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Leiste mit Optionen -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="Parser" Content="Parser" Command="{Binding ParserCommand}" Margin="5" Background="{Binding ParserBackground}"/>
            <Button x:Name="Adressbuch" Content="Adressbuch" Command="{Binding AdressbuchCommand}" Margin="5" Background="{Binding AdressbuchBackground}"/>
            <Button x:Name="Einstellungen" Content="Einstellungen" Command="{Binding EinstellungenCommand}" Margin="5" Background="{Binding EinstellungenBackground}"/>
        </StackPanel>

        <!-- Container für UserControls -->
        <Grid Grid.Row="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Parser -->
            <contactParseOverview:ContactParseOverviewControl x:Name="ContactParseOverviewControl" Grid.Column="0" Grid.Row="0" Visibility="{Binding ContactParseOverviewVisibility}"/>

            <!-- Übersicht -->
            <contactList:ContactListControl x:Name="ContactListControl" Grid.Column="0" Grid.Row="0" Visibility="{Binding ContactListVisibility}"/>

            <!-- Einstellungen -->
            <settings:SettingsControl x:Name="SettingsControl" Grid.Column="0" Grid.Row="0" Visibility="{Binding SettingsVisibility}"/>
        </Grid>
    </Grid>
</UserControl>

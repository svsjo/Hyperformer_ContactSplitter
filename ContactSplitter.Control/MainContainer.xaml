<UserControl x:Class="ContactSplitter.Control.MainContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactSplitter.Control"
             xmlns:contactParseOverview="clr-namespace:ContactSplitter.Control.ContactParseOverview"
             xmlns:contactList="clr-namespace:ContactSplitter.Control.ContactList"
             xmlns:settings="clr-namespace:ContactSplitter.Control.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Leiste mit Optionen -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="Parser" Content="Parser" Click="Parser_Click" Margin="5"/>
            <Button x:Name="Adressbuch" Content="Adressbuch" Click="Adressbuch_Click" Margin="5"/>
            <Button x:Name="Einstellungen" Content="Einstellungen" Click="Einstellungen_Click" Margin="5"/>
        </StackPanel>

        <!-- Container für UserControls -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Parser -->
            <contactParseOverview:ContactParseOverviewControl x:Name="ContactParseOverviewControl" Grid.Column="0" Grid.Row="0" Visibility="Visible"/>

            <!-- Übersicht -->
            <contactList:ContactListControl x:Name="ContactListControl" Grid.Column="0" Grid.Row="0" Visibility="Collapsed"/>

            <!-- Bearbeiten 
            <local:ContactEditControl x:Name="ContactEditControl" Grid.Column="0" Grid.Row="0" Visibility="Collapsed"/> -->

            <!-- Einstellungen -->
            <settings:SettingsControl x:Name="SettingsControl" Grid.Column="0" Grid.Row="0" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="ContactSplitter.Control.UserGuideControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ContactSplitter.Control.UserGuide"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=local:UserGuideViewModel}">
    <Grid>
        <ScrollViewer CanContentScroll="True">
            <StackPanel Orientation="Vertical" CanVerticallyScroll="True">
                <ui:Card Margin="10" Footer="TODO" Content="Bedieneranleitung"></ui:Card>
                <ui:Card Margin="10" Footer="TODO" Content="Best Practices und Grenzfälle"></ui:Card>
                <ui:Card Margin="10" Footer="Jonathan Schwab, Felix Wochele, Seva Pypenko, Jonas Weis" Content="Infos zum Entwicklerteam"></ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
